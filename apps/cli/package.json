{
  "name": "@taskforge/cli",
  "version": "0.1.0",
  "description": "TaskForge command-line interface (tf): one terminal, multiple coding agents, one controlled workflow.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "tf": "./dist/bin.js",
    "taskforge": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@taskforge/shared": "workspace:*",
    "@taskforge/persistence": "workspace:*",
    "@taskforge/execution": "workspace:*",
    "@taskforge/workspace": "workspace:*",
    "@taskforge/agents": "workspace:*",
    "@taskforge/core": "workspace:*",
    "@taskforge/verification": "workspace:*",
    "@taskforge/integration": "workspace:*",
    "@taskforge/scheduler": "workspace:*",
    "@taskforge/planner": "workspace:*",
    "@taskforge/negotiation": "workspace:*",
    "@taskforge/router": "workspace:*",
    "@taskforge/collaboration": "workspace:*",
    "@taskforge/operator": "workspace:*",
    "@taskforge/conversation": "workspace:*",
    "@taskforge/plugins": "workspace:*",
    "@taskforge/telemetry": "workspace:*",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eder/taskforge.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/eder/taskforge/issues"
  },
  "homepage": "https://github.com/eder/taskforge#readme",
  "publishConfig": {
    "access": "public"
  }
}
